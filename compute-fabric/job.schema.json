{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZeYu Compute Fabric Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "git_commit", "command", "environment", "timeout"],
  "properties": {
    "project": {"type": "string", "minLength": 1, "description": "A worker-configured local repository alias"},
    "git_commit": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "argv; first item {python} resolves the configured runtime; no implicit shell"},
    "arguments": {"type": "array", "items": {"type": "string"}, "default": []},
    "environment": {"type": "string", "minLength": 1},
    "timeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
    "artifact_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": [], "description": "Relative forward-slash globs. Runtime rejects absolute paths, traversal, links and special files."},
    "env": {"type": "object", "additionalProperties": {"type": "string"}, "default": {}, "description": "Only names explicitly allowed by worker allowed_job_env"},
    "resources": {"type": "object", "additionalProperties": false, "properties": {
      "gpu": {"type": "boolean"},
      "min_vram_mb": {"type": "integer", "minimum": 0},
      "min_ram_mb": {"type": "integer", "minimum": 0}
    }}
  }
}
